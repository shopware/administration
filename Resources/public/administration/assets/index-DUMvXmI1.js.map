{# v-on="$listeners" needed becaues vue/compat removes them from $attrs #}
{# New mt-url-field component #}
{% block sw_url_field %}
<mt-url-field
    v-if="useMeteorComponent"
    v-bind="$attrs"
    v-model="realValue"
>
    <template
        v-for="(index, name) in getSlots()"
        #[name]="data"
    >
        <slot
            :name="name"
            v-bind="data || {}"
        >
        </slot>
    </template>
</mt-url-field>
{% endblock %}

{# v-on="$listeners" needed becaues vue/compat removes them from $attrs #}
{# Deprecated component #}
{% block sw_url_field_deprecated %}
<sw-url-field-deprecated
    v-else
    v-bind="$attrs"
    v-model:value="realValue"
>
    <template
        v-for="(index, name) in getSlots()"
        #[name]="data"
    >
        <slot
            :name="name"
            v-bind="data || {}"
        >
        </slot>
    </template>
</sw-url-field-deprecated>
{% endblock %}
